+static void ConfigureSocket(int fd) {
+    int flag = 1;
+    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &flag, sizeof(flag));
+
+    const int sndbuf = 8192;
+    setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &sndbuf, sizeof(sndbuf));
+
+    const int flags = fcntl(fd, F_GETFL, 0);
+    if (flags >= 0) {
+        fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+    }
+}
+
+static bool WaitForNonBlockingConnect(int fd, int timeout_ms, int& error_out) {
+    fd_set write_fds;
+    FD_ZERO(&write_fds);
+    FD_SET(fd, &write_fds);
+
+    struct timeval timeout;
+    timeout.tv_sec = timeout_ms / 1000;
+    timeout.tv_usec = (timeout_ms % 1000) * 1000;
+
+    int ret = select(fd + 1, nullptr, &write_fds, nullptr, &timeout);
+    if (ret < 0) {
+        error_out = errno;
+        return false;
+    }
+    if (ret == 0) {
+        error_out = ETIMEDOUT;
+        return false;
+    }
+
+    int socket_error = 0;
+    socklen_t opt_len = sizeof(socket_error);
+    if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &socket_error, &opt_len) < 0) {
+        error_out = errno;
+        return false;
+    }
+    if (socket_error != 0) {
+        error_out = socket_error;
+        return false;
+    }
+
+    error_out = 0;
+    return true;
+}
+
+static bool WaitForWritable(int fd, int timeout_ms, int& error_out) {
+    fd_set write_fds;
+    FD_ZERO(&write_fds);
+    FD_SET(fd, &write_fds);
+
+    struct timeval timeout;
+    timeout.tv_sec = timeout_ms / 1000;
+    timeout.tv_usec = (timeout_ms % 1000) * 1000;
+
+    int ret = select(fd + 1, nullptr, &write_fds, nullptr, &timeout);
+    if (ret < 0) {
+        error_out = errno;
+        return false;
+    }
+    if (ret == 0) {
+        error_out = ETIMEDOUT;
+        return false;
+    }
+
+    int socket_error = 0;
+    socklen_t opt_len = sizeof(socket_error);
+    if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &socket_error, &opt_len) < 0) {
+        error_out = errno;
+        return false;
+    }
+    if (socket_error != 0) {
+        error_out = socket_error;
+        return false;
+    }
+
+    error_out = 0;
+    return true;
+}
