                 "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_oye.csv\"",
                 "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                 "CONFIG_MMAP_FILE_NAME_LENGTH=32",
                 "CONFIG_FLASH_EXPRESSION_ASSETS=y",
                 "CONFIG_USE_OYE_BLE_PROVISIONING=y",
                 "CONFIG_USE_OYE_CLOUD_API=y",
                 "CONFIG_OYE_API_BASE_URL=\"http://192.168.11.7:8000\""
             ]
        }
    ]
}